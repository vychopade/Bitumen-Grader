# Python bytecode and virtualenvs
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Secrets (this app has none; keep the pattern anyway)
.env
.env.*
*.pem

# Packaging / build output
build/
dist/
*.spec.bak

# Node (not used here; exclude if added later)
node_modules/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*~

# Trained checkpoints — regenerate on the Train page
models/*.pt
models/*.json
